+CFLAGS += -DOPENSSL_USE_NODELETE
+CFLAGS += -DNDEBUG
+CFLAGS += -DOPENSSLDIR="\"/root/myroot/ssl\""
+CFLAGS += -DOPENSSL_API_COMPAT=0x10100000L
+CFLAGS += -DOPENSSL_NO_DYNAMIC_ENGINE
+CFLAGS += -DOPENSSL_PIC
