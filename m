+CFLAGS += -Icrypto/include
+CFLAGS += -Icrypto
+CFLAGS += -Icrypto/modes
+CFLAGS += -I.
+CFLAGS += -DENGINESDIR="\"/root/myroot/lib/engines-1.1\""
